# Copy to ~/.openclaw/ops-pack.env and fill in. Every script in this pack reads
# these as plain environment variables (source this file before running them,
# or let install.sh wire it into your shell profile / cron environment).

# --- paths -------------------------------------------------------------
OPS_STATE_DIR="$HOME/.openclaw/state"
OPS_LOG_DIR="$HOME/.openclaw/logs"
OPS_KEYWORDS_FILE="$HOME/.openclaw/ops-pack-keywords.txt"

# --- mail-sweep.py -------------------------------------------------------
# Composio account IDs to sweep, "label=account_id" pairs, comma separated.
OPS_MAIL_ACCOUNTS="work=your_composio_account_id,personal=your_other_account_id"

# --- loops-brief.py ------------------------------------------------------
# Three markdown files this pack reads a daily brief from. Any of the three
# can point at the same file, or be left unset (that section is skipped).
OPS_REGISTER_FILE="$HOME/Documents/open-loops-register.md"
OPS_TRACKER_FILE="$HOME/Documents/outbox-tracker.md"
OPS_LEDGER_FILE="$HOME/Documents/ledger.md"

# --- ledger-diff.sh --------------------------------------------------------
# Directory to watch, plus a comma-separated list of files inside it (relative
# paths) to snapshot and diff daily.
OPS_WATCH_DIR="$HOME/Documents"
OPS_WATCH_FILES="ledger.md,outbox-tracker.md,open-loops-register.md"

# --- calendar-next.sh --------------------------------------------------------
# Calendar.app calendar names to skip, comma separated.
OPS_EXCLUDE_CALENDARS="Birthdays,Siri Suggestions,Holidays"

# --- telegram-send.sh --------------------------------------------------------
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# --- cf-cost-tracker.sh --------------------------------------------------------
CF_API_TOKEN=""
CF_ACCOUNT_ID=""
CF_WORKER_NAME="your-worker"
CF_CREDIT_TOTAL_USD="5000"
CF_CREDIT_EXPIRY="2027-01-01"
CF_PACE_START="2026-01-01"

# --- council.py (multi-model draft/decision review) -------------------------
CF_AI_GATEWAY="atlas"
CF_COUNCIL_PROJECT="default"
GEMINI_API_KEY=""
NVIDIA_API_KEY=""
DEEPSEEK_API_KEY=""
